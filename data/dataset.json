      "question": "Calculate the profit margin if revenue is $80M and profit is $12M",
      "category": "standard_knowledge",
      "difficulty": "easy",
      "expected_behavior": {
        "tools": ["calculator"],
        "tool_order": "any",
        "min_tools": 1,
        "max_tools": 1
      },
      "ground_truth": {
        "type": "calculation",
        "answer": "15%",
        "exact_value": 15,
        "formula": "Profit Margin = (Profit / Revenue) * 100 = (12 / 80) * 100 = 15%",
        "validation": {
          "exact_match": 15,
          "tolerance": 0.1,
          "accept_percentage_sign": true
        }
      },
      "evaluation": {
        "correctness_threshold": 0.95,
        "must_cite_sources": false,
        "allows_approximation": false
      }
